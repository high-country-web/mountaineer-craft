DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_LOG_WEBHOOK_URL=
PLAYER_ANALYTICS_URL=
PLAYER_ANALYTICS_USERNAME=
PLAYER_ANALYTICS_PASSWORD=
GITHUB_TOKEN=

# Optional plugin checker settings. Run the bot with bot/ as its working directory.
PLUGIN_UPDATES_FILE=src/data/plugins.json
# Leave empty to disable hourly Discord alerts; /plugin-updates still works.
PLUGIN_UPDATES_CHANNEL_ID=
PLUGIN_UPDATES_STATE_FILE=src/data/plugin-update-state.json
# Optional: read installed versions from the Minecraft startup log.
# Use the same Panel settings as the Go backend; these must also be set on the bot.
PTERODACTYL_PANEL_URL=
PTERODACTYL_MINECRAFT_SERVER_ID=
PTERODACTYL_CLIENT_API_KEY=

# Paste these settings into the Coolify Compose resource's environment variables.
# Replace placeholders; do not commit real credentials.
REDIS_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-mountaineer-craft-oauth-application-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
BOT_DISCORD_CLIENT_ID=your-mountaineer-helper-application-id
DISCORD_GUILD_ID=your-discord-server-id
DISCORD_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me
DISCORD_REDIRECT_URI=https://mountaineercraft.net/oauth/discord
PLAN_API_URL=https://analytics.mountaineercraft.net
PLAN_API_USERNAME=apiuser
PLAN_API_PASSWORD=your-plan-password
PLAN_SERVER_ID=
PTERODACTYL_PANEL_URL=https://your-panel.example.com
PTERODACTYL_MINECRAFT_SERVER_ID=abcd1234
PTERODACTYL_CLIENT_API_KEY=your-panel-client-api-key
# Optional: GitHub token for a higher public release API rate limit.
GITHUB_TOKEN=
# Optional: alerts stay disabled until a Discord channel ID is supplied.
PLUGIN_UPDATES_CHANNEL_ID=
# Optional image overrides; :sha-<commit> pins a coordinated release or rollback.
BACKEND_IMAGE=ghcr.io/high-country-web/mountaineer-craft-backend:latest
BOT_IMAGE=ghcr.io/high-country-web/mountaineer-craft-bot:latest

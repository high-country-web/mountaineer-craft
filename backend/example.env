PORT=":4002"
GIN_MODE=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/oauth/discord
DISCORD_REQUIRED_GUILD_ID=
JWT_SECRET=
PLAN_API_URL=https://analytics.mountaineercraft.net
PLAN_API_USERNAME=apiuser
PLAN_API_PASSWORD=
# Optional: select a single server rather than Plan's default scope.
PLAN_SERVER_ID=

# Optional: read Plan's DiscordSRV username data to suggest a player profile.
# Use a database user with SELECT access to Plan's extension tables.
PLAN_DB_HOST=
PLAN_DB_PORT=3306
PLAN_DB_NAME=
PLAN_DB_USER=
PLAN_DB_PASSWORD=
# true requires verified TLS; false explicitly allows an unencrypted connection.
PLAN_DB_TLS=true

PORT=":4002"
GIN_MODE=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/oauth/discord
DISCORD_REQUIRED_GUILD_ID=
JWT_SECRET=
PLAN_API_URL=https://analytics.mountaineercraft.net
PLAN_API_USERNAME=apiuser
PLAN_API_PASSWORD=
# Optional: select a single server rather than Plan's default scope.
PLAN_SERVER_ID=

# Read live DiscordSRV account links through the Pterodactyl Client API.
# Use the short 8-character Minecraft server ID from its Panel URL.
# Keep the Client API key on the backend only, never in frontend variables.
PTERODACTYL_PANEL_URL=
PTERODACTYL_MINECRAFT_SERVER_ID=
PTERODACTYL_CLIENT_API_KEY=

# Alternative: local file access when all PTERODACTYL_* settings above are empty.
# Path must be readable inside the Go backend.
# For a separate API container, mount the DiscordSRV directory read-only and
# use its mounted path (e.g. /mnt/discordsrv/accounts.aof).
DISCORDSRV_ACCOUNTS_FILE=
